# Password you type to sign in (use something long; this app holds people's phone numbers).
APP_PASSWORD=

# Random string, 32+ characters, used to sign the login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase Postgres connection string. Use the "Transaction pooler" URL (port 6543).
# Leave empty for local development: the app then stores data in ./.data/pglite.
DATABASE_URL=

# Optional fallback timezone for "today" until you sign in (your browser's timezone is used after that).
APP_TIMEZONE=
