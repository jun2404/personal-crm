# Optional, only for upgrading from the single-password version: the old sign-in password.
# While contacts saved before accounts existed are unclaimed, the sign-up page offers to move them
# into the new account if you enter this. Remove it once you've created your account.
APP_PASSWORD=

# Random string, 32+ characters, used to sign the login cookie. Changing it signs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase Postgres connection string. Use the "Transaction pooler" URL (port 6543).
# Leave empty for local development: the app then stores data in ./.data/pglite.
DATABASE_URL=

# Optional fallback timezone for "today" until you sign in (your browser's timezone is used after that).
APP_TIMEZONE=
